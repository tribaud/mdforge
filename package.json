{
  "name": "mdforge",
  "displayName": "MDForge",
  "description": "Transform VS Code into a Typora-like WYSIWYG Markdown editor with GitHub-style rendering, Mermaid diagrams and rich task lists.",
  "version": "0.2.6",
  "publisher": "tribaud",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tribaud/mdforge.git"
  },
  "homepage": "https://github.com/tribaud/mdforge#readme",
  "bugs": {
    "url": "https://github.com/tribaud/mdforge/issues"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "markdown",
    "wysiwyg",
    "editor",
    "typora",
    "mermaid",
    "github",
    "task list",
    "checkbox",
    "preview"
  ],
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "mdforge.editor",
        "displayName": "MDForge",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "mdforge.openEditor",
        "title": "MDForge: Open with MDForge",
        "category": "MDForge",
        "icon": "mdforge-editor.svg"
      },
      {
        "command": "mdforge.openWithTextEditor",
        "title": "MDForge: Reopen with Text Editor",
        "category": "MDForge",
        "icon": "$(code)"
      },
      {
        "command": "mdforge.togglePresentation",
        "title": "MDForge: Toggle Presentation Mode",
        "category": "MDForge"
      },
      {
        "command": "mdforge.openDiffOriginal",
        "title": "MDForge: Open Original Side in MDForge",
        "category": "MDForge",
        "icon": "mdforge-editor.svg"
      },
      {
        "command": "mdforge.openDiffModified",
        "title": "MDForge: Open Modified Side in MDForge",
        "category": "MDForge",
        "icon": "mdforge-editor.svg"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "mdforge.outline",
          "name": "MDForge Outline",
          "when": "mdforge.active"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "when": "resourceLangId == markdown",
          "command": "mdforge.openEditor",
          "group": "navigation@20"
        }
      ],
      "editor/title/context": [
        {
          "when": "resourceLangId == markdown",
          "command": "mdforge.openEditor",
          "group": "1_open"
        }
      ],
      "editor/title": [
        {
          "when": "resourceLangId == markdown && !isInDiffEditor && activeCustomEditorId != 'mdforge.editor'",
          "command": "mdforge.openEditor",
          "group": "navigation"
        },
        {
          "when": "activeCustomEditorId == 'mdforge.editor'",
          "command": "mdforge.openWithTextEditor",
          "group": "navigation"
        },
        {
          "when": "isInDiffEditor && resourceLangId == markdown",
          "command": "mdforge.openDiffOriginal",
          "group": "navigation@1"
        },
        {
          "when": "isInDiffEditor && resourceLangId == markdown",
          "command": "mdforge.openDiffModified",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "key": "ctrl+shift+alt+m",
        "mac": "cmd+shift+alt+m",
        "command": "mdforge.openEditor",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "key": "ctrl+shift+alt+p",
        "mac": "cmd+shift+alt+p",
        "command": "mdforge.togglePresentation",
        "when": "mdforge.active"
      }
    ],
    "configuration": {
      "title": "MDForge",
      "properties": {
        "mdforge.engine": {
          "type": "string",
          "enum": [
            "milkdown",
            "codemirror"
          ],
          "enumDescriptions": [
            "Milkdown/ProseMirror WYSIWYG engine (the editor may reformat the Markdown source on save).",
            "CodeMirror 6 live-preview engine (the Markdown source is never reformatted; supports Cmd+F search, code folding and block drag)."
          ],
          "default": "codemirror",
          "description": "Editor engine. Reopen the note (or run 'Developer: Reload Window') after changing this."
        },
        "mdforge.checkbox.enableInProgress": {
          "type": "boolean",
          "default": true,
          "description": "Enable the custom [~] 'in progress' state in the checkbox click cycle (empty -> in progress -> done)."
        },
        "mdforge.fontSize": {
          "type": "number",
          "default": 15,
          "minimum": 8,
          "maximum": 48,
          "description": "Editor font size (px)."
        },
        "mdforge.pageWidth": {
          "type": "string",
          "enum": [
            "comfortable",
            "full"
          ],
          "default": "comfortable",
          "description": "Content width: 'comfortable' centers a readable column (GitHub-like), 'full' spans the viewport."
        },
        "mdforge.paste.appendSource": {
          "type": "boolean",
          "default": false,
          "description": "When pasting from a web page, append a '> <label> <url>' blockquote below the paste and place the caret on it (the source URL is auto-filled only if the clipboard carries one)."
        },
        "mdforge.paste.sourceLabel": {
          "type": "string",
          "default": "À partir de l'adresse",
          "description": "Label used by mdforge.paste.appendSource before the URL."
        },
        "mdforge.debug.pasteHtml": {
          "type": "boolean",
          "default": false,
          "description": "Debug: on paste, open the raw clipboard HTML/plain-text in a new tab (to inspect what a web page actually puts on the clipboard, e.g. math markup)."
        },
        "mdforge.textAlign": {
          "type": "string",
          "enum": [
            "left",
            "justify"
          ],
          "default": "left",
          "markdownEnumDescriptions": [
            "Paragraphs align left (default).",
            "Paragraphs are justified. Display-only — no HTML is written to the Markdown."
          ],
          "description": "Text alignment for paragraphs in the editor view (viewer preference; not stored in the file)."
        },
        "mdforge.images.folder": {
          "type": "string",
          "default": "assets",
          "description": "Folder (relative to the note) where pasted/dropped/picked images are saved. Empty = next to the note."
        },
        "mdforge.images.naming": {
          "type": "string",
          "default": "${noteName}-${hash}",
          "markdownDescription": "File name pattern for saved images. Tokens: `${noteName}` (note file name without extension), `${hash}` (content hash), `${originalName}` (original file name without extension). The default mirrors the vault convention `NoteName-<hash>.ext`."
        },
        "mdforge.images.hashLength": {
          "type": "number",
          "default": 8,
          "minimum": 4,
          "maximum": 32,
          "description": "Number of hex characters of the content MD5 hash used in the image file name."
        },
        "mdforge.mermaid.theme": {
          "type": "string",
          "enum": [
            "auto",
            "default",
            "dark",
            "neutral",
            "forest"
          ],
          "default": "auto",
          "markdownEnumDescriptions": [
            "Follow the VS Code theme (dark editor → dark diagrams).",
            "Mermaid 'default' theme (light).",
            "Mermaid 'dark' theme.",
            "Mermaid 'neutral' theme (grayscale, print-friendly).",
            "Mermaid 'forest' theme (green)."
          ],
          "description": "Theme used to render Mermaid diagrams."
        },
        "mdforge.images.renameOnChange": {
          "type": "string",
          "enum": [
            "prompt",
            "auto",
            "off"
          ],
          "default": "prompt",
          "markdownEnumDescriptions": [
            "Ask before renaming a changed image so its `<hash>` matches the new content.",
            "Rename automatically (and update the link) when a changed image's content hash drifts.",
            "Never rename on change (the `<hash>` in the file name may become stale)."
          ],
          "description": "When a co-located image's content changes, its content hash in the file name drifts. This controls whether MDForge re-hashes (renames) it and updates the link."
        },
        "mdforge.images.linkStyle": {
          "type": "string",
          "enum": [
            "markdown",
            "wikilink-embed"
          ],
          "default": "markdown",
          "markdownEnumDescriptions": [
            "Standard Markdown image link `![](assets/...)` (round-trips with the vault asset scripts).",
            "Obsidian embed `![[assets/...]]` (inserted as literal text; not rendered as an image yet)."
          ],
          "description": "How an inserted image is written into the Markdown."
        }
      }
    }
  },
  "scripts": {
    "compile:ext": "tsc -p ./",
    "build:webview": "node esbuild.mjs",
    "build": "npm run compile:ext && npm run build:webview",
    "watch:ext": "tsc -watch -p ./",
    "watch:webview": "node esbuild.mjs --watch",
    "preview": "node scripts/cm-preview.mjs",
    "vscode:prepublish": "npm run build",
    "package": "vsce package"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "@milkdown/core": "^7.5.0",
    "@milkdown/ctx": "^7.5.0",
    "@milkdown/plugin-block": "^7.21.3",
    "@milkdown/plugin-clipboard": "^7.5.0",
    "@milkdown/plugin-diagram": "^7.5.0",
    "@milkdown/plugin-history": "^7.5.0",
    "@milkdown/plugin-listener": "^7.5.0",
    "@milkdown/plugin-math": "^7.5.0",
    "@milkdown/plugin-slash": "^7.21.3",
    "@milkdown/plugin-tooltip": "^7.21.3",
    "@milkdown/preset-commonmark": "^7.5.0",
    "@milkdown/preset-gfm": "^7.5.0",
    "@milkdown/prose": "^7.5.0",
    "@milkdown/transformer": "^7.5.0",
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.6",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.25.0",
    "katex": "^0.16.11",
    "mathml-to-latex": "^1.8.0",
    "mermaid": "^11.16.0",
    "playwright-core": "^1.62.1",
    "prosemirror-highlight": "^0.15.3",
    "remark-frontmatter": "^5.0.0",
    "shiki": "^1.29.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5.6.0"
  }
}
